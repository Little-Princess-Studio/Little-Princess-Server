{
    "type": "server",

    "entity_namespace": "LPS.Server.Demo.Logic.Entity",
    "rpc_property_namespace": "LPS.Server.Demo.Logic.RpcProperty",
    "rpc_stub_interface_namespace": "LPS.Server.Demo.Logic.RpcStub",

    "servers": {
        "server0" : {
            "ip": "127.0.0.1",
            "port": 12001,
            // host0_immediate test variant: server0 uses TCP (ImmediateHostManagerConnectionOfServer)
            // so the reconnect integration test exercises that code path.
            "use_mq_to_host": false,
            "use_mq_to_service_manager": true
        },
        "server1": {
            "ip": "127.0.0.1",
            "port": 12011,
            "use_mq_to_host": true,
            "use_mq_to_service_manager": false
        }
    },

    "hostmanager_conf": "Config/host0_immediate/hostmanager.conf.json",
    "mq_conf": "Config/host0_immediate/mq.conf.json",
    "globalcache_conf": "Config/host0_immediate/globalcache.conf.json"
}

