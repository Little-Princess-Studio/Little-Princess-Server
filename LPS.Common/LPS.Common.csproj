<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CodeAnalysisRuleSet>../Default.ruleset</CodeAnalysisRuleSet>
    <LangVersion>12</LangVersion>
    <!--
      ThirdParty/ contains vendored sources (kcp2k) that are NOT first-party
      code. Skip StyleCop analyzers on them so we do not have to fight
      upstream's formatting. License notices stay in LICENSE.kcp2k.
    -->
    <NoWarn>$(NoWarn);SA0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude vendored kcp2k from StyleCop's analyzer pass via the
         .editorconfig that lives under ThirdParty/. The .cs files still
         compile, but the analyzers don't complain about Mirror's style. -->
    <None Include="ThirdParty\.editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.19.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="NLog" Version="5.0.0-preview.3" />
    <PackageReference Include="Rougamo.Fody" Version="2.3.0" PrivateAssets="contentfiles;analyzers"/>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="../stylecop.json" />
    <PackageReference Include="System.IO.Pipelines" Version="7.0.0" />
  </ItemGroup>

</Project>
